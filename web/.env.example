# Copy to .env.local for local development.
# Both values are PUBLIC — they ship in the browser bundle. No secrets here.

# Which chain the app reads from before a wallet connects.
#   46630 = Robinhood Chain testnet (default in code)
#   31337 = local Anvil
NEXT_PUBLIC_DEFAULT_CHAIN=46630

# WalletConnect / Reown project id, from https://cloud.reown.com
# Has a working default in wagmi.ts, so this is only needed to point at a
# different Reown project.
NEXT_PUBLIC_WALLETCONNECT_ID=

# Canonical origin, used for the app name/icon wallets show when connecting.
# Set this if you attach a custom domain.
NEXT_PUBLIC_APP_URL=
